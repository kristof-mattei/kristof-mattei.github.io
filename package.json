{
    "name": "kristof-mattei",
    "type": "module",
    "scripts": {
        "format": "oxfmt",
        "prepare": "husky"
    },
    "devDependencies": {
        "husky": "9.1.7",
        "lint-staged": "17.6.0",
        "oxfmt": "0.71.0"
    },
    "lint-staged": {
        "*.sh": [
            "shfmt --diff --apply-ignore --"
        ],
        "*": [
            "oxfmt --check --no-error-on-unmatched-pattern --"
        ]
    },
    "engines": {
        "node": "26.10.0"
    },
    "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45"
}
